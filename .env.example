# Copy to .env only if your process manager loads it. Never commit .env.
APP_DATA_DIR=./data
APP_COOKIE_SECURE=1
APP_ALLOWED_ORIGINS=https://tax.example.com
APP_SESSION_TTL_SECONDS=28800

# Used only once when the security database contains no users.
# Prefer: python manage_users.py create admin --role admin
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Required outside the managed Windows launcher. Generate 32 random bytes and
# encode them with URL-safe base64. Never commit the real value or rotate it
# without first re-encrypting all stored user credentials.
APP_LLM_MASTER_KEY=

OLLAMA_BASE=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
