{
  "metadata": {
    "version": "v3.0-executable",
    "total_chains": 9,
    "updated_at": "2026-07-23"
  },
  "evidence_chains": [
    {
      "id": "evid-001",
      "rule_id": 21,
      "name": "银行收款与申报收入断裂→多源验证闭环",
      "min_evidence": 3,
      "steps": [
        {
          "step": 1,
          "op": "aggregate",
          "desc": "必备维度·收款总额验证：统计全量银行贷方收款总额（排除内部转账/理财申赎），按月份汇总各月实际资金流入。此维度为证据闭环的必备入口——无银行流水则本证据链不可用。",
          "source": "bank_txs",
          "filters": {
            "credit": {
              ">": 0
            }
          },
          "group_by": "month",
          "fields": [
            "sum(credit) as total_bank"
          ],
          "output": "evid_total_bank"
        },
        {
          "step": 2,
          "op": "aggregate",
          "desc": "必备维度·申报收入验证：统计全量销项发票价税合计销售额，按月份汇总各月已申报销售规模。与收款总额形成一对一的月份比对基础。",
          "source": "sal_invs",
          "group_by": "month",
          "fields": [
            "sum(total) as total_sales"
          ],
          "output": "evid_total_sales"
        },
        {
          "step": 3,
          "op": "compare",
          "desc": "核心维度·差额比对：逐月比对收款总额与申报销售额，计算差额和差异率。差异>申报销售额10%的月份→标记为异常。此比对是隐匿收入证据的第一来源——收款远多于申报，且超出正常商业信用账期所能解释的范围（一般信用账期不超过90天），则隐匿收入的推断成立。",
          "left": "evid_total_bank",
          "right": "evid_total_sales",
          "threshold": {
            "gt": "total_sales * 0.1"
          },
          "output": "evid_gap"
        },
        {
          "step": 4,
          "op": "query",
          "desc": "核心维度·无票收款对手方验证：按收款对手方分组汇总，筛选出未能匹配到销项发票购买方的收款记录。无票收款对手方越多、金额越大→隐匿收入证据越强。此维度与线索链步骤4联动——线索链锁定对手方，证据链量化规模和持续性。",
          "source": "bank_txs",
          "filters": {
            "credit": {
              ">": 0
            }
          },
          "group_by": "counterparty",
          "fields": [
            "sum(credit) as unreported"
          ],
          "output": "evid_unreported"
        },
        {
          "step": 5,
          "op": "query",
          "desc": "辅助维度·持续性验证：统计存在收款记录的月份数量。收款差异持续超过6个月→排除偶发的跨期开票/客户延迟付款等正常商业解释→隐匿收入为系统性行为而非偶然疏忽，证据强度升级。",
          "source": "bank_txs",
          "filters": {
            "credit": {
              ">": 0
            }
          },
          "group_by": "month",
          "fields": [
            "count(*) as month_count"
          ],
          "output": "evid_persistence"
        },
        {
          "step": 6,
          "op": "conclude",
          "desc": "证据闭环判定：必备维度（收款vs申报差异）+核心维度（无票收款对手方）+辅助维度（持续性≥6个月）→三维同时命中=证据闭环成立。min_evidence=3，达到3维命中即可作为稽查证据提交。单维或双维命中→标记为部分闭环，需补充证据后升级。",
          "conditions": [
            {
              "if": "evid_gap.is_anomaly",
              "conclusion": "收款vs申报差异验证",
              "severity": "必备维度确认",
              "detail": "银行收款总额与申报销售额存在显著差异"
            },
            {
              "if": "evid_unreported exists",
              "conclusion": "无票收款验证",
              "severity": "核心维度确认",
              "detail": "存在无对应销项发票的收款对手方"
            },
            {
              "if": "evid_persistence month_count > 6",
              "conclusion": "持续性验证",
              "severity": "辅助维度确认",
              "detail": "收款差异持续超过6个月，排除偶发跨期等正常商业解释"
            }
          ],
          "output": "findings"
        }
      ],
      "sub_topic": "跨域证据",
      "level": "高风险"
    },
    {
      "id": "evid-002",
      "rule_id": 1,
      "name": "资产负债表不平→账外资金循环多源验证闭环",
      "min_evidence": 3,
      "steps": [
        {
          "step": 1,
          "op": "aggregate",
          "desc": "必备维度·会计恒等式验证：从科目余额表逐科目汇总期末余额，资产类(1开头编码)借方余额vs负债权益类(2/4开头编码)贷方余额的差额。差额>资产总额0.5%且>5万元→恒等式断裂成立。注意：此维度必须用科目余额表(trial_balance)而非序时账(vouchers)——序时账借贷永远相等无法检测恒等式断裂。服务行业(资产轻)阈值收紧至0.3%/3万元，制造业(存货重)放宽至1%/10万元。",
          "source": "trial_balance",
          "group_by": "period",
          "fields": [
            "sum(close_debit) as evid_assets",
            "sum(close_credit) as evid_liab_equity"
          ],
          "output": "evid_balance_equation"
        },
        {
          "step": 2,
          "op": "query",
          "desc": "核心维度·科目偏离度检测：按科目编码分组统计各科目的借贷方差额，计算偏离度=abs(科目余额)/总差额。偏离度>30%的科目标记为异常归属科目。往来科目(科目编码以1122/1123/1221/2202/2203/2241开头的应收应付类)异常偏离→典型账外循环信号——利用往来科目作为隐匿收入或虚增成本的蓄水池。",
          "source": "vouchers",
          "group_by": "account_code",
          "fields": [
            "sum(debit) as acc_debit",
            "sum(credit) as acc_credit"
          ],
          "output": "evid_account_deviation"
        },
        {
          "step": 3,
          "op": "query",
          "desc": "核心维度·资金流向追踪：按对手方汇总银行流水收支，筛选大额(>10万元)且对方为个人或关联企业的交易。追踪资金从企业→个人账户的流出路径。资金流与账面挂账方向一致→资金体外循环的证据强度从怀疑升级为确认。此维度与线索链步骤5联动——线索链锁定账户范围，证据链量化规模和路径。",
          "source": "bank_txs",
          "filters": {
            "credit": {
              ">": 0
            }
          },
          "group_by": "counterparty",
          "fields": [
            "sum(credit) as inflow",
            "sum(debit) as outflow"
          ],
          "output": "evid_fund_trace"
        },
        {
          "step": 4,
          "op": "query",
          "desc": "核心维度·系统日志取证：检查序时账(vouchers)中是否存在以下异常操作痕迹：①凭证编号不连续(存在删除/插入)→可能删除真实分录后重新编号 ②同一日期凭证量异常(>日均3倍)→批量补录或虚假分录集中生成 ③凭证制单人与审核人为同一人→内控失效。三类痕迹叠加→系统性造假概率显著升高。",
          "source": "vouchers",
          "group_by": "date",
          "fields": [
            "count(*) as daily_voucher_count"
          ],
          "output": "evid_system_trace"
        },
        {
          "step": 5,
          "op": "query",
          "desc": "辅助维度·持续性检测：统计存在差额异常的会计期间数量。差额持续>6个月且绝对值逐月扩大→排除偶发差错，确认为系统性异常→证据强度升级。持续<2个月→标记为存疑，不入正式结论，建议跟踪3个申报期后重新评估。",
          "source": "vouchers",
          "group_by": "period",
          "fields": [
            "count(*) as period_count"
          ],
          "output": "evid_persistence"
        },
        {
          "step": 6,
          "op": "conclude",
          "desc": "证据闭环判定：必备维度(恒等式断裂)+核心维度(科目偏离+资金追踪+系统痕迹)+辅助维度(持续性≥6个月)→达到min_evidence=3即可闭环。三维以上全命中→铁证级，可作处罚依据。双维命中→强证据级，标注部分闭环需补证。单维命中→线索级，不入结论仅跟踪观察。",
          "conditions": [
            {
              "if": "evid_balance_equation exists",
              "conclusion": "会计恒等式验证",
              "severity": "必备维度确认",
              "detail": "资产负债表存在>0.5%且>5万元的差额"
            },
            {
              "if": "evid_account_deviation exists",
              "conclusion": "科目偏离度验证",
              "severity": "核心维度确认",
              "detail": "差额集中归属于往来科目，存在异常偏离"
            },
            {
              "if": "evid_fund_trace exists",
              "conclusion": "资金流向验证",
              "severity": "核心维度确认",
              "detail": "银行流水锁定资金从企业→个人账户的流出路径"
            },
            {
              "if": "evid_system_trace exists",
              "conclusion": "系统操作痕迹验证",
              "severity": "核心维度确认",
              "detail": "存在凭证编号不连续/批量生成等异常操作痕迹"
            }
          ],
          "output": "findings"
        }
      ],
      "sub_topic": "跨域证据",
      "level": "高风险"
    },
    {
      "id": "evid-003",
      "rule_id": 2,
      "sub_topic": "跨域证据",
      "level": "极高风险",
      "name": "月凭证量异常→虚构交易多源验证闭环",
      "min_evidence": 3,
      "steps": [
        {
          "step": 1,
          "op": "aggregate",
          "source": "vouchers",
          "group_by": "month",
          "fields": [
            "count(*) as evid_monthly_count"
          ],
          "output": "evid_voucher_count",
          "desc": "必备维度·凭证量基准验证：从序时账按月统计凭证总量，与同行业同规模企业均值比对。凭证量>行业均值2倍（制造业2.5倍/服务业1.5倍）→虚构交易证据体系的第一道闸门——凭证量不高则根本不存在虚构交易嫌疑。"
        },
        {
          "step": 2,
          "op": "query",
          "source": "vouchers",
          "group_by": "account_code",
          "fields": [
            "count(*) as acc_entry_count"
          ],
          "output": "evid_structure",
          "desc": "核心维度·凭证结构检测：按科目分类统计采购报销类凭证占比。采购+报销>80%→虚构交易高危信号。正常企业采购报销类占比40-60%，超过80%只有两种解释：①业务全部是采购报销（无销售收入凭证？）→逻辑不自洽 ②采购报销是伪造的→后者概率远大于前者。"
        },
        {
          "step": 3,
          "op": "query",
          "source": "vouchers",
          "group_by": "account_code",
          "fields": [
            "sum(debit) as total_amount",
            "count(*) as big_count"
          ],
          "output": "evid_four_certs",
          "desc": "核心维度·交易实质四证验证：对大额（>10万）凭证逐笔核查四证齐全性（合同+发票+入库单/业务记录+付款回单）。四证全缺→纯虚构交易。四证不全（缺2证以上）→疑似虚构。仅有发票但缺其他三证→可能是虚开发票套现。"
        },
        {
          "step": 4,
          "op": "query",
          "source": "bank_txs",
          "group_by": "counterparty",
          "fields": [
            "sum(debit) as paid",
            "count(*) as pay_count"
          ],
          "output": "evid_payment_match",
          "desc": "核心维度·资金支付验证：从银行流水追踪异常凭证对应的付款记录。付款与凭证金额差>10%→不是同一笔交易。付款对手方与凭证供应商不一致→三流断裂。付款时间早于凭证日期>30天→先付后补票掩盖虚构交易。"
        },
        {
          "step": 5,
          "op": "conclude",
          "desc": "证据闭环判定：必备维度（凭证量超2倍）+核心维度（结构异常+四证缺失+付款不一致）→达到min_evidence=3即可闭环。四维全命中→铁证级可作处罚依据。三维命中→强证据级限期补证。双维→线索级不入结论。单维→存疑不入结论。",
          "conditions": [
            {
              "if": "evid_voucher_count exists",
              "conclusion": "凭证量基准验证",
              "severity": "必备维度确认",
              "detail": "月凭证量超过行业均值2倍"
            },
            {
              "if": "evid_structure exists",
              "conclusion": "凭证结构验证",
              "severity": "核心维度确认",
              "detail": "采购报销类凭证占比超过80%"
            },
            {
              "if": "evid_four_certs exists",
              "conclusion": "交易实质验证",
              "severity": "核心维度确认",
              "detail": "大额凭证四证不全（缺合同/入库/付款回单）"
            },
            {
              "if": "evid_payment_match exists",
              "conclusion": "资金支付验证",
              "severity": "核心维度确认",
              "detail": "银行付款与凭证金额/对手方/时间不一致"
            }
          ],
          "output": "findings"
        }
      ]
    },
    {
      "id": "evid-004",
      "rule_id": 3,
      "sub_topic": "跨域证据",
      "level": "高风险",
      "name": "固定资产折旧缺失->虚增资产多源验证闭环",
      "min_evidence": 3,
      "steps": [
        {
          "step": 1,
          "op": "query",
          "source": "fixed_assets",
          "group_by": "asset_id",
          "fields": [
            "sum(original_value) as value"
          ],
          "output": "evid_depreciation_gap",
          "desc": "必备维度:筛选入账超6月且折旧=0的资产。折旧缺失金额超10万/年->折旧完整性断裂。此维度是证据体系基石。"
        },
        {
          "step": 2,
          "op": "aggregate",
          "source": "vouchers",
          "group_by": "month",
          "fields": [
            "sum(credit) as monthly_dep"
          ],
          "output": "evid_profit_loss_dep",
          "desc": "核心维度:汇总折旧类分录每月总额。利润表折旧<理论折旧x70%->折旧严重偏低利润被虚增。"
        },
        {
          "step": 3,
          "op": "query",
          "source": "fixed_assets",
          "group_by": "asset_category",
          "fields": [
            "count(*) as cnt"
          ],
          "output": "evid_policy_consistency",
          "desc": "核心维度:同类别资产是否一致折旧方法？混合不一致->选择性适用->人为调节利润。"
        },
        {
          "step": 4,
          "op": "query",
          "source": "fixed_assets",
          "group_by": "asset_id",
          "fields": [
            "sum(original_value) as val"
          ],
          "output": "evid_physical_existence",
          "desc": "核心维度:折旧为0大额资产能否提供实物+合同+发票+付款？五证缺二->资产极可能不存在。"
        },
        {
          "step": 5,
          "op": "query",
          "source": "bank_txs",
          "group_by": "counterparty",
          "fields": [
            "sum(debit) as paid"
          ],
          "output": "evid_payment_verify",
          "desc": "核心维度:异常资产有银行付款记录？无付款->无真实交易->虚构资产。"
        },
        {
          "step": 6,
          "op": "conclude",
          "desc": "证据闭环:必备(折旧缺失)+核心(利润表+政策+实物+付款)->min_evidence=3闭环。五维->铁证。四维->强证据。三维->线索。",
          "conditions": [
            {
              "if": "evid_depreciation_gap exists",
              "conclusion": "折旧缺失验证",
              "severity": "必备维度确认",
              "detail": "入账超6月且折旧=0金额超10万/年"
            },
            {
              "if": "evid_physical_existence exists",
              "conclusion": "资产实物验证",
              "severity": "核心维度确认",
              "detail": "折旧为零资产无法提供实物证据"
            },
            {
              "if": "evid_payment_verify exists",
              "conclusion": "资金支付验证",
              "severity": "核心维度确认",
              "detail": "银行流水无对应资产购置付款"
            }
          ],
          "output": "findings"
        }
      ]
    },
    {
      "id": "evid-005",
      "rule_id": 4,
      "sub_topic": "跨域证据",
      "level": "高风险",
      "name": "无形资产摊销缺失->虚增无形资产多源验证闭环",
      "min_evidence": 3,
      "steps": [
        {
          "step": 1,
          "op": "query",
          "source": "intangible_assets",
          "group_by": "asset_id",
          "fields": [
            "sum(original_value) as value"
          ],
          "output": "evid_amort_gap",
          "desc": "必备维度-摊销缺失验证:筛选入账超12月且月摊销额=0的资产。科技/软件/医药超5万触发。此维度是整个证据体系的基石-如所有无形资产按期摊销则不存在本条疑点。"
        },
        {
          "step": 2,
          "op": "aggregate",
          "source": "vouchers",
          "group_by": "month",
          "fields": [
            "sum(credit) as monthly_amort"
          ],
          "output": "evid_profit_loss_amort",
          "desc": "核心维度-利润表摊销费用验证:汇总摊销类分录每月总额。利润表摊销<理论摊销x70%-摊销严重偏低利润被虚增。"
        },
        {
          "step": 3,
          "op": "query",
          "source": "intangible_assets",
          "group_by": "asset_type",
          "fields": [
            "count(*) as cnt"
          ],
          "output": "evid_policy_consistency",
          "desc": "核心维度-摊销政策一致性:同类型无形资产是否采用一致摊销方法？混合不一致-选择性适用-人为调节利润而非系统故障。"
        },
        {
          "step": 4,
          "op": "query",
          "source": "intangible_assets",
          "group_by": "asset_id",
          "fields": [
            "sum(original_value) as val"
          ],
          "output": "evid_ownership",
