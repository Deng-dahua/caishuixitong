{
  "version": "1.0",
  "description": "行业自适应知识库 — 不同行业的基准参数、风险权重、重点关注域",
  "industries": {
    "制造业": {
      "label": "制造业",
      "subtypes": [
        "纺织",
        "纺织产品",
        "服装",
        "电子",
        "机械",
        "化工",
        "食品",
        "金属制品",
        "塑料制品"
      ],
      "benchmarks": {
        "gross_margin_pct": {
          "low": 8,
          "normal_low": 12,
          "normal_high": 30,
          "high": 40,
          "note": "制造业毛利率因细分行业差异大，纺织/服装偏低(8-20%)，电子/机械偏高(20-40%)"
        },
        "purchase_sales_ratio": {
          "normal_low": 0.85,
          "normal_high": 1.15,
          "note": "正常范围0.85-1.15，<0.7为购销严重倒挂"
        },
        "supplier_concentration_warn": 60,
        "customer_concentration_warn": 60
      },
      "signal_weights": {
        "存在加工费": 0.8,
        "制造业加工链条待验证": 1.5,
        "购销严重倒挂": 1.3,
        "无工资记录": 1.0,
        "供应商高度集中": 1.0
      },
      "focus_domains": [
        "经营实质分析",
        "上下游穿透分析",
        "经营实质地理分析",
        "发票实质性审计"
      ],
      "always_check": [
        "BOM表",
        "加工合同",
        "出入库记录",
        "产能匹配"
      ],
      "exempt_signals": [
        "高采购金额占比是制造业正常特征，不单独构成警告"
      ],
      "risk_patterns": [
        {
          "name": "加工链条断裂",
          "signals": [
            "存在加工费",
            "BOM缺失",
            "有进无销或有销无进"
          ],
          "explanation": "制造业最核心风险：有加工费但无BOM表→品名差异无法解释→虚开嫌疑"
        },
        {
          "name": "产能不匹配",
          "signals": [
            "高销项金额",
            "低工资",
            "低水电支出"
          ],
          "explanation": "产出与投入要素不匹配→可能存在虚开发票或隐匿外协加工"
        }
      ]
    },
    "贸易批发": {
      "label": "贸易/批发",
      "subtypes": [
        "贸易",
        "批发",
        "零售",
        "商贸",
        "进出口"
      ],
      "benchmarks": {
        "gross_margin_pct": {
          "low": 3,
          "normal_low": 5,
          "normal_high": 20,
          "high": 30,
          "note": "贸易企业毛利率低(3-20%)，批发最低(3-8%)，零售偏高(15-25%)"
        },
        "purchase_sales_ratio": {
          "normal_low": 0.8,
          "normal_high": 1.05,
          "note": "贸易企业购销比通常接近1.0，<0.6为异常"
        },
        "supplier_concentration_warn": 50,
        "customer_concentration_warn": 50
      },
      "signal_weights": {
        "购销严重倒挂": 1.5,
        "毛利率异常偏高": 1.3,
        "销项发票连号": 1.2,
        "供应商高度集中": 1.2,
        "客户高度集中": 1.2
      },
      "focus_domains": [
        "经营实质分析",
        "发票实质性审计",
        "上下游穿透分析",
        "供应商画像分析"
      ],
      "always_check": [
        "进销存台账",
        "物流单据",
        "购销合同"
      ],
      "exempt_signals": [
        "贸易企业不存在加工费，无需BOM表验证"
      ],
      "risk_patterns": [
        {
          "name": "空转贸易",
          "signals": [
            "购销金额接近",
            "供应商客户重叠",
            "无物流单据"
          ],
          "explanation": "贸易企业经典虚开模式：买入卖出金额接近、交易对手重叠→资金空转→无真实货物"
        },
        {
          "name": "毛利率异常",
          "signals": [
            "毛利率偏高",
            "进销价格偏离市场"
          ],
          "explanation": "贸易企业毛利率异常偏高→可能关联交易定价操纵或隐匿部分采购成本"
        }
      ]
    },
    "建筑装饰": {
      "label": "建筑/装饰",
