          "explanation": "农产品收购发票可自行开具→虚开重灾区→虚构收购数量/金额"
        },
        {
          "name": "免税政策滥用",
          "signals": [
            "全部销售申报为免税",
            "实际为非自产产品"
          ],
          "explanation": "将非自产农产品冒充自产享受免税→典型的骗税行为"
        }
      ]
