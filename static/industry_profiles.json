        },
        "purchase_sales_ratio": {
          "normal_low": 0.75,
          "normal_high": 1.1,
          "note": "建筑企业有分包/劳务外协，进项可能包含大量分包费"
        },
        "supplier_concentration_warn": 50,
        "customer_concentration_warn": 70
      },
      "signal_weights": {
        "购销严重倒挂": 1.0,
        "发票连号": 1.5,
        "季度末集中开票": 1.5,
        "个人付款方占比过高": 1.3
      },
      "focus_domains": [
        "经营实质分析",
        "发票实质性审计",
        "供应商画像分析",
        "工资社保比对"
      ],
      "always_check": [
        "项目合同",
        "工程结算单",
        "劳务分包合同",
        "农民工工资专户"
      ],
      "exempt_signals": [
        "建筑企业项目制导致收入确认时点集中，季度末集中开票属正常"
      ],
      "risk_patterns": [
        {
          "name": "挂靠经营",
          "signals": [
            "无工资或有工资无社保",
            "大量劳务分包",
            "项目经理个人签约"
          ],
          "explanation": "建筑企业经典挂靠模式：资质方收取管理费，实际施工方自负盈亏→税务责任不清"
        },
        {
          "name": "材料虚列",
          "signals": [
            "建材采购占比异常高",
            "无入库记录",
            "供应商集中在同一地区"
          ],
          "explanation": "以材料采购名义虚开发票→虚增进项→虚列成本"
        }
      ]
    },
    "服务业": {
      "label": "服务业",
      "subtypes": [
        "服务",
        "咨询",
        "餐饮",
        "住宿",
        "教育",
        "医疗",
        "设计",
        "广告"
      ],
      "benchmarks": {
        "gross_margin_pct": {
          "low": 20,
          "normal_low": 30,
          "normal_high": 60,
          "high": 75,
          "note": "服务业毛利率较高(30-60%)，主要成本为人工和房租"
        },
        "purchase_sales_ratio": {
          "normal_low": 0.3,
          "normal_high": 0.7,
          "note": "服务业进销比较低（主要成本是人工而非货物采购），<0.3需关注"
        },
        "supplier_concentration_warn": 70,
        "customer_concentration_warn": 60
      },
      "signal_weights": {
        "无工资记录": 1.8,
        "购销严重倒挂": 0.5,
        "毛利率异常偏高": 0.5,
        "服务类发票占比异常": 1.5,
        "个人付款方占比过高": 0.8
      },
      "focus_domains": [
        "工资社保比对",
        "人员与业务匹配",
        "经营实质分析",
        "发票实质性审计"
      ],
      "always_check": [
        "劳动合同",
        "社保缴纳记录",
        "服务合同及成果交付"
      ],
      "exempt_signals": [
        "服务业不以货物进销为核心，购销倒挂信号降权"
      ],
      "risk_patterns": [
        {
          "name": "虚增人工成本",
          "signals": [
            "工资费用高",
            "人员数量与业务量不匹配",
            "社保人数≠工资人数"
          ],
          "explanation": "服务业以人工为主要成本→虚列人头是最常见的偷税手段"
        },
        {
          "name": "服务真实性存疑",
          "signals": [
            "大额服务费",
            "无服务成果交付记录",
            "服务对象单一"
          ],
          "explanation": "服务交易无形性→是否为真实服务还是以服务名义转移资金"
        }
      ]
    },
