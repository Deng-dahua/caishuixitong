  "dynamic_entries": {
    "note": "**动态渲染**的写入口（由 JS 拼 HTML）没法用 HTML 属性注入，改由渲染模板自带 `data-perm` + 渲染后调用 `window.RBAC.reapply()`。本表登记以实现『漏配检测』。",
    "static/js/documents.js": [
      {
        "marker": "data-act=\\\"del\\\"",
        "perm": "document.write",
        "what": "列表行内『删除』"
      },
      {
        "marker": "data-save=",
        "perm": "document.write",
        "what": "解析结果详情内『保存』校正"
      }
    ],
    "static/js/extract.js": [
