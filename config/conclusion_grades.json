{
  "schema": "caishuixitong.conclusion_grades/1",
  "version": "1.0.0",
  "updated": "2026-10-18",
  "note": "结论分级的唯一权威（WB-TRISK-2026-001 §3.1/§3.2）。四级：L1 风险指标命中 / L2 待核线索 / L3 风险事项成立 / L4 违法认定。系统自身只能输出 L1~L3；L4 必须由有权人员人工确认，引擎遇到 L4 一律降级为 L3 并标注。",
  "grades": [
    {
      "id": "L1",
      "code": "indicator_hit",
      "cn": "风险指标命中",
      "meaning": "仅触发条件被数据命中，尚未做构成要件核对。",
      "allow_determinative_words": false,
      "allow_risk_level": [
        "信息",
        "待核验"
      ],
      "required_text": [
        "本轮仅命中风险指标",
        "不作认定"
      ]
    },
    {
      "id": "L2",
      "code": "pending_clue",
      "cn": "待核线索",
      "meaning": "账内已读到与风险指向一致的信号，但构成要件未逐条核对成立，或关键证据缺失。",
      "allow_determinative_words": false,
      "allow_risk_level": [
        "待核验",
        "低风险"
      ],
      "required_text": [
        "待核",
        "不作定性"
      ]
    },
    {
      "id": "L3",
      "code": "item_established",
      "cn": "风险事项成立",
      "meaning": "构成要件逐条核对成立，且关键证据齐备（闭合度达标、无直接证据缺失）。",
      "allow_determinative_words": true,
      "allow_risk_level": [
        "低风险",
        "中风险",
        "高风险",
        "极高风险"
      ],
      "required_text": [],
      "min_closure": 0.8,
      "require_no_direct_missing": true
    },
    {
      "id": "L4",
      "code": "illegal_determined",
      "cn": "违法认定",
      "meaning": "行政机关依法作出的定性。系统永不输出，必须转交有权人员。",
      "allow_determinative_words": false,
      "allow_risk_level": [],
      "engine_must_downgrade_to": "L3",
      "required_text": [
        "须由有权人员依法认定"
      ]
    }
  ],
  "verdict_mapping": {
    "note": "把既有 engine/argumentation.py 的裁决词映射到四级，避免语言漂移。★键必须与 engine/argumentation.py 的 _VERDICT_* / GRADE_* 常量**逐字一致**，由 engine/conclusion_grade.py::verdict_vocab_consistency() 双向校验。未登记的词一律按 L2 处理并在门禁报 WARN。",
    "authority": "engine/argumentation.py",
    "已触碰税务违规红线（资料齐全，可作初步判断）": "L3",
    "触碰税务违规红线": "L3",
    "疑似触碰税务违规红线（资料不足，待补充资料后判断）": "L2",
    "经核查未触碰违规红线（已有合理解释）": "L2",
    "现有资料不足以形成税务疑点": "L1",
    "账内检出需外部数据核验的信号（不作定性，待外部核验后再判断）": "L2",
    "本项已查明的风险": "L2",
    "本项已查明的风险；未认定到构成要件": "L2",
    "本项属待核事项": "L2",
    "已核定": "L3",
    "待核": "L2",
    "已排除": "L2",
    "经识别属正当情形（本项不作风险定性，仅作处理区分）": "L2"
  },
  "veto_rules": {
    "note": "★关键证据一票否决（§3.1）。命中任一条即禁止该项输出定性词，并强制其结论等级不高于 L2。",
    "determinative_words": [
      "已查明",
      "已认定",
      "认定成立",
      "构成偷税",
      "认定为偷税",
      "定性成立",
      "已触碰",
      "违法行为",
      "逃税",
      "虚开成立",
      "确认虚开",
      "确定违法"
    ],
    "triggers": [
      {
        "id": "V1",
        "when": "closure == 0 或 evidence_have == 0",
        "why": "无任何证据被取得"
      },
      {
        "id": "V2",
        "when": "closure < min_closure(0.8)",
        "why": "证据链未闭合"
      },
      {
        "id": "V3",
        "when": "direct_missing 为真",
        "why": "直接证据缺失"
      },
      {
        "id": "V4",
        "when": "missing_material_names 非空且未全部登记替代资料",
        "why": "关键资料缺失且无替代程序"
      },
      {
        "id": "V5",
        "when": "存在风险等级但无 closure 字段",
        "why": "等级无证据支撑（无闭合度即无依据）"
      },
      {
        "id": "V6",
        "when": "conclusion_grade 缺失或为占位",
        "why": "结论等级未登记"
      }
    ],
    "on_veto": {
      "max_risk_level": "待核验",
      "append_text": "（关键证据缺失，本项不作认定）",
      "gate_severity": "ERROR"
    }
  },
  "level_vocab": {
    "note": "★风险等级合法词表。**本表必须与 engine/risk_levels.py 的 LEGAL_LEVELS 逐字一致**，由 engine/conclusion_grade.py::vocab_consistency() 双向校验；不一致即 ERROR（防止两套词表并存）。",
    "authority": "engine/risk_levels.LEGAL_LEVELS",
    "legal": [
      "极高风险",
      "高风险",
      "中风险",
      "低风险",
      "待核验",
      "信息"
    ],
    "risk_grades": [
      "极高风险",
      "高风险",
      "中风险",
      "低风险",
      "信息"
    ],
    "evidence_states": [
      "待核验"
    ],
    "severity": {
      "极高风险": 5,
      "高风险": 4,
      "中风险": 3,
      "待核验": 2,
      "低风险": 1,
      "信息": 0
    }
  },
  "term_authority": {
    "note": "★ 报告**结论用语**唯一权威（用户条款《专注税务风险检查条款》第4条）。报告结论只能使用下列四个术语；L4「违法认定」只能由有权机关作出，系统不得作出。",
    "terms": [
      "风险信号",
      "待核事项",
      "已认定事实",
      "违法认定"
    ],
    "by_grade": {
      "L1": "风险信号",
      "L2": "待核事项",
      "L3": "已认定事实",
      "L4": "违法认定"
    },
    "forbidden_determinative": [
      "已查明违法",
      "已认定违法",
      "构成偷税",
      "属于偷税",
      "定性成立",
      "确认虚开",
      "确定违法",
      "应认定为违法"
    ]
  }
}
