  "params": {
    "_note": "★ 唯一权威：本批 12 条外部规则的**全部阈值集中在此**，不得写进代码分支（项目铁律：同一阈值多处各写一份 = 多头维护事故）。新增同类对象 = 加一行数据。",
    "VAT-004": {
      "growth_gap": 0.3,
      "output_growth_floor": 0.2,
      "_basis": "销项税增速 − 进项税增速 > 0.3 且 销项税增速 > 0.2；按月度聚合计算期间变动"
    },
    "VAT-008": {
      "night_ratio": 0.2,
      "night_hours": [
        22,
        23,
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "min_invoices": 10,
      "_basis": "夜间（22:00–次日 06:00）开票占比 > 0.2；样本不足 min_invoices 张不出结论"
    },
    "VAT-014": {
      "_basis": "简易计税销售额 > 0 且 一般计税进项已抵扣 > 0；需申报表附列资料（本账套无 ⇒ 置疑补资料）"
    },
    "VAT-015": {
      "diff_ratio": 0.1,
      "_basis": "|预缴增值税 − 申报增值税| / 申报增值税 > 0.1；需《增值税预缴税款表》"
    },
    "VAT-021": {
      "diff_amount": 0.0,
      "_basis": "差额征税销售额 − 扣除额 > diff_amount（默认 >0 即提示）；需申报表附列资料（差额征税栏）"
    },
    "VAT-024": {
      "months": 3,
      "amount_threshold": 1000000.0,
      "min_invoices": 20,
      "_basis": "成立后 months 个月内开票金额 > amount_threshold 且张数 ≥ min_invoices"
    },
    "CIT-002": {
      "volatility": 0.5,
      "_basis": "|本期所得税税负率 − 上期| / 上期 > 0.5；需两期企业所得税申报表"
    },
    "CIT-003": {
      "diff_ratio": 0.3,
      "_basis": "|应纳税所得额 − 利润总额| / 利润总额 > 0.3；需企业所得税年度申报表（A100000）"
    },
    "CIT-007": {
      "diff_ratio": 0.3,
      "_basis": "|预缴企业所得税 − 汇算应纳| / 汇算应纳 > 0.3；需季度预缴表与年度汇算表"
    },
    "CIT-019": {
      "_basis": "不征税收入 > 0 且其对应支出已税前扣除；需不征税收入专项资料与 A105040"
    },
    "CIT-020": {
      "_basis": "免税收入 > 0 且其对应成本已税前扣除；需免税项目核算资料"
    },
    "CIT-030": {
      "_basis": "账载税会差异 > 已调整差异；需 A105000 纳税调整项目明细表"
    }
  },
