{
  "schema": 1,
  "name": "外部规则清单 V1.0（VAT 30 + CIT 30）的落地登记表",
  "purpose": "把外部清单与系统**已有检测能力**逐条对齐：① 清单变量 → 系统数据字典的映射（防「取数为 0」）；② 每条清单规则的覆盖状态与对应检测器；③ 真缺的按系统范式落地（VR 规则，查实层，不新增红线）。",
  "why": "外部清单自带 YAML 字段模板与规则内联阈值。本系统架构与之一致的三点（法规引用不硬编码 / 规则版本化 / 先小范围上线）直接采纳；**不兼容的四点**（① 规则载体是 Python+JSON 非 YAML；② 阈值唯一权威集中在 industry_benchmark/redline_benchmark/tax_rates，不允许每条规则各写一份；③ 规则不自带 score（等级唯一权威 engine/risk_levels.py）；④ 红线含「要件+反证」结构、禁止自动定性）在此显式登记，避免把清单直接导入而破坏单一权威。",
  "discipline": [
    "★ 新增同类对象 = 加一行数据，不改逻辑分支。",
    "覆盖状态枚举：covered（已有强对应）/ partial（部分覆盖，方向对、维度或口径不同）/ missing（真缺，已落地为 VR）。",
    "本表只登记「清单 vs 系统」的对照与落地，**不新增红线**（红线条数被 91 处文档/闸门绑定）。"
  ],
  "var_map": {
    "_note": "清单变量 → 系统真实取数口径。★ 清单里的变量名（vat_burden/invoice_sales…）**不是**系统数据字典的键；必须经本表映射，否则取数为 0。",
    "bank_receipts": "bank_txs[].credit 合计（方向=收入）；口径唯一权威 engine/bank_nature.py（经营性/非经营性）",
    "invoice_sales": "sal_invs 合计（不含税）＝ Σ[amount]；口径唯一权威 engine/tax_rates.py（账载收入不含税）",
    "declared_sales": "tax_declarations[].sales_amount（_declaration_type=vat）",
    "output_tax": "tax_declarations[].sales_tax；或 Σ sal_invs[].tax",
    "input_tax": "tax_declarations[].input_tax；或 Σ pur_invs[].tax",
    "vat_payable": "tax_declarations[].payable_tax；或 trial_balance 科目「应交税费/未交增值税」",
    "vat_burden": "派生＝output_tax 净额 / sales_revenue；行业均值取 engine/industry_benchmark「税负率」",
    "industry_avg_*": "engine/industry_benchmark.resolve_benchmark(industry, metric)；指标集：毛利率/净利率/税负率/进销比/人均营收/期间费用率",
    "market_rate / 同期同类贷款利率": "engine/redline_benchmark.resolve_loan_rate_benchmark(as_of)（1 年期 LPR，来源=人民银行公告）",
    "top_input_goods / top_output_goods": "pur_invs[].goods / sal_invs[].goods 按金额聚合后取 TOP；字段读取唯一权威 engine/fieldkit.py",
    "input_qty / output_qty": "pur_invs[].qty / sal_invs[].qty",
    "month_end_invoice_amount": "sal_invs[].date 落在月末最后 N 天（engine/invoice_pattern_detector._MONTH_END_DAYS）",
    "night_invoice_count": "sal_invs[].date 的**时间部分**（真实数据形如 '2025-01-22 13:42:19'，可解析）",
    "void_invoice_amount": "inv_status 含「作废/红冲」的发票金额",
    "abnormal_invoice_count": "pur_invs[] 的 inv_status / risk_level 含异常特征词（税局风险标注）",
    "extra_price_income": "vouchers 科目含「营业外收入/其他收益」+ 摘要命中价外费用关键词（违约金/赔偿金/包装费…）",
    "AR_growth / revenue_growth": "trial_balance 应收账款 / 主营业务收入的**期间变动**（单期数据 ⇒ 需上期或序时账分月）；收入口径禁取期末余额",
    "inventory_change / cost_of_sales_change": "进销存台账 inventory_ledger；无台账 ⇒ 置疑（禁按账面倒推）",
    "applied_vat_rate": "sal_invs[].tax_rate；正确税率由品名/税码推定（engine/tax_rates.py + fieldkit.goods_name）",
    "entertainment_expense / advertising_expense": "vouchers 科目聚合 → 已有 VR038 / VR039",
    "interest_expense / equity": "vouchers 财务费用/利息支出；trial_balance 所有者权益 → 已有 RL-CIT-009/010",
    "salary_total / iit_total / social_security_total": "salaries[].salary / salaries[].tax / social_security[].due_amount",
    "shareholder_loan_balance / loan_days": "trial_balance 其他应收款 + 对象=股东/六员 → 已有 VR030 + 专项探测器",
    "cit_payable / profit_total / taxable_income": "**需企业所得税申报表**（本账套未上传 ⇒ 只能在有该表时计算，否则置疑列明需补资料）",
    "tax_accounting_diff / adjusted_diff": "需 A105000 纳税调整明细表（同上）",
    "prepaid_vat / prepaid_cit / annual_cit": "需《增值税预缴税款表》/ 企业所得税季度预缴与年度汇算表（本账套未上传）",
    "tax_exempt_sales / simplified_tax_sales / difference_tax_sales": "需增值税申报表附列资料（免税/简易计税/差额征税栏次）",
    "contract_amount": "合同台账 contracts（本账套未上传 ⇒ 有数据才算）",
    "refund_amount / refund_condition": "需退税审批与退税凭证（本账套未上传）"
  },
