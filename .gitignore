# 形如 industry_data.json.bak-20260925141545 的带时间戳备份
# （注意：.gitignore 的 # 注释只能独占一行，不能写在规则行尾，否则会被当字面量）
*.bak-*
*.tmp

# 分析验证产物（大文件，非源码）
scripts/four_reports/

# 运行期自学习/记忆/日志状态文件（机器本地、可重生成，不进版本库）
static/audit_memory.json
static/cross_analysis_memory.json
